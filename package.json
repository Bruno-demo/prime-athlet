{
  "name": "sport-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:ngrok": "node --env-file=.env.local scripts/dev-ngrok.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "seed:products": "node --env-file=.env.local scripts/seed-products.mjs",
    "seed:all": "node --env-file=.env.local scripts/seed-products.mjs",
    "db:wipe": "node --env-file=.env.local scripts/seed-products.mjs --wipe-only",
    "sync:sport-category": "node --env-file=.env.local scripts/sync-sport-category.mjs --fix",
    "sync:sport-category:check": "node --env-file=.env.local scripts/sync-sport-category.mjs --check",
    "prod:preflight": "node --env-file=.env.local scripts/prod-preflight.mjs",
    "prod:gate": "npm run prod:preflight && npm run lint && npm run build && npm run test:e2e",
    "qa:viewport": "node scripts/run-viewport-qa.mjs",
    "qa:viewport:auth": "node scripts/run-auth-viewport-qa.mjs",
    "protect:branch": "powershell -ExecutionPolicy Bypass -File scripts/enforce-branch-protection.ps1",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@types/nodemailer": "^7.0.9",
    "lucide-react": "^0.564.0",
    "mongodb": "^7.1.0",
    "next": "16.1.6",
    "nodemailer": "^8.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^20.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "ngrok": "^5.0.0-beta.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
